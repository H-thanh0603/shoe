# Copy thành .env rồi đổi giá trị. KHÔNG commit .env.
DATABASE_URL=postgresql://kinetic:kinetic@localhost:5432/kinetic
JWT_SECRET=đổi-chuỗi-này-khi-deploy
PORT=3000
# Bridge agent (agents/run_bridge.sh) — secret phải khớp 2 bên
BRIDGE_URL=http://127.0.0.1:4001
BRIDGE_SECRET=doi-chuoi-nay
# ——— caching / scale ngang ———
# Bỏ trống = memory-only (dev). Deploy: REDIS_URL=redis://localhost:6379
REDIS_URL=
CACHE_TTL_SEC=60
CACHE_MAX_KEYS=1000
# Scale dọc 1 máy: CLUSTER_WORKERS=4 (số CPU). Compose scale ngang: --scale app=3
CLUSTER_WORKERS=
# JOBS_ENABLED=false → tắt worker nền trong process API (khi chạy worker riêng)
JOBS_ENABLED=true
# WORKER_ONLY=true → process chỉ chạy jobs, không mở port
WORKER_ONLY=false
# Sau nginx/LB/Docker: TRUST_PROXY=1 để rate-limit thấy đúng IP client
TRUST_PROXY=0
# ——— VNPay (sandbox mặc định — lấy key tại https://sandbox.vnpayment.vn) ———
# Bỏ trống TMN_CODE → checkout vnpay trả PAYMENT_UNAVAILABLE (chỉ COD chạy)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Public URL VNPay redirect về (prod phải là domain thật + https)
VNPAY_RETURN_URL=/api/v1/payments/vnpay/return
# ——— Agentic Web manifests (agent.json/ai-plugin.json/llms.txt) ———
# Base URL ghi trong manifest khi chạy sau proxy không đọc được Host chuẩn.
# Bỏ trống → tự suy từ request (req.protocol + Host header).
PUBLIC_BASE_URL=
# ——— SMTP mail xác nhận đơn ———
# Bỏ trống SMTP_HOST → mailer skip an toàn (job vẫn done, chỉ log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KINETIC <no-reply@kinetic.vn>

# ——— AI / Agent (shopping assistant + internal gateway) ———
# Đổi provider/model CHỈ cần env — không sửa code. Chi tiết: docs/AI_PROVIDERS.md
# Provider: deepseek | openrouter | openai | anthropic | gemini | tokenrouter | mock | custom:<name>
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
# Key provider chính (hoặc dùng biến riêng provider: DEEPSEEK_API_KEY…)
AI_API_KEY=
# Fallback chain (tùy chọn): provider dự phòng khi chính lỗi/qua rate limit
# AI_PROVIDER_FALLBACKS=openrouter,gemini
# Retry/Fallback tuning: số lần thử lại 1 provider trước khi chuyển
# AI_MAX_RETRIES=2
# Timeout 1 model call (ms)
# AI_TIMEOUT_MS=120000
# Agent loop: số vòng tool-call tối đa 1 turn, token tối đa 1 call
# AI_MAX_ROUNDS=8
# AI_MAX_TOKENS=2048
# Tool result fence (chars)
# AI_TOOL_RESULT_MAX_CHARS=12000
# Budget ngày chống burn tiền: số turn assistant tối đa / IP / ngày (mặc định 100)
# AI_DAILY_TURNS_PER_IP=100
# Session assistant: số phiên + turn tối đa
# AI_MAX_SESSIONS=200
# AI_MAX_TURNS=30
# Session store: memory (1 replica/dev) | redis (multi-instance qua LB —
# history chat share giữa các replica; auto = dùng redis nếu REDIS_URL sẵn)
# AI_SESSION_STORE=auto
# Log: info | debug (debug log request/response đã redact)
# AI_LOG_LEVEL=info
# ——— Key từng provider (đặt cái bạn dùng) ———
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# ——— Internal LLM gateway (cho Python bridge / agent ngoài) ———
# Secret bắt buộc nếu muốn bật /api/v1/internal/llm/messages; bỏ trống = tắt.
INTERNAL_LLM_SECRET=

# --- PII at rest (#10) ---
# AES-256-GCM cho customer_name/phone/email + shipping_address trong bảng orders.
# Sinh key: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Production BẮT BUỘC set (thiếu → PII lưu plaintext + boot log cảnh báo).
# QUAN TRỌNG: mất key = mất dữ liệu PII của đơn enc — backup key cẩn thận.
PII_KEY=

# --- Seed admin (Phase 0: không còn credential mặc định) ---
# server/seed.js chỉ tạo admin khi cả 2 biến này set. Prod: set + đổi pass ngay.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- Metrics gate (Phase 0: /metrics không còn public) ---
# Set khi deploy để alerter/LB gửi header x-metrics-secret. Bỏ trống = chỉ localhost đọc được.
# METRICS_SECRET=

# --- Error tracking (Phase 1: Sentry không dep mới) ---
# Bỏ trống = chỉ log stderr. Set DSN để lỗi 500 + unhandled tự đẩy về Sentry (không gửi PII).
# SENTRY_DSN=

# VNPay refund API v2.1.1 (admin hủy đơn đã paid → tự hoàn tiền)
# Sandbox mặc định; production: portal VNPay cấp URL riêng
# VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchantv2.1.1/refundserver/refund.html
# VNPAY_REFUND_TIMEOUT_MS=20000

# --- Alerting (scripts/alert.js — compose service 'alerter' chạy mỗi 60s) ---
# Không cấu hình Telegram vẫn chạy (log stdout). Lấy token: @BotFather tạo bot,
# chat_id: nhắn bot rồi GET https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_API_URL=http://127.0.0.1:3000
# ALERT_JOBS_FAILED_MAX=3
# ALERT_AI_ERROR_RATE=0.5
# ALERT_COOLDOWN_MIN=30
