# Copy thành agents/.env rồi điền giá trị (KHÔNG commit .env — đã gitignore).
# Nạp bằng: set -a; source agents/.env; set +a  (run_demo.py tự nạp)

# --- Shop ---
KINETIC_API=http://localhost:3100
KINETIC_WEB_URL=http://localhost:3100
KINETIC_ADMIN_EMAIL=admin@kinetic.vn
KINETIC_ADMIN_PASSWORD=doi-mat-khau-nay

# --- LLM: 1 biến chọn provider ---
# gateway (mặc định) — Node gateway của server KINETIC dịch Anthropic Messages
# format sang provider đang cấu hình trong server/.env (deepseek/openrouter/
# gemini/mock/…). Đổi provider/model KHÔNG đụng file này — xem docs/AI_PROVIDERS.md.
# KHÔNG cần LiteLLM proxy :4000 nữa.
ASSISTANT_PROVIDER=gateway   # gateway | anthropic
KINETIC_LLM_BASE_URL=http://127.0.0.1:3000/api/v1/internal/llm
# Phải trùng INTERNAL_LLM_SECRET trong server/.env:
KINETIC_LLM_API_KEY=
# Model theo tác vụ (gateway dùng model của server/.env — các biến này chỉ
# hiệu lực khi ASSISTANT_PROVIDER=anthropic):
KINETIC_SHOPPING_MODEL=deepseek-chat
KINETIC_MERCHANT_MODEL=deepseek-chat
KINETIC_MEMORY_MODEL=deepseek-chat

# --- Bridge cho chat web (agents/run_bridge.sh + server/.env) ---
# Secret nội bộ Express <-> bridge, phải KHỚP với BRIDGE_SECRET trong server/.env:
BRIDGE_SECRET=doi-chuoi-nay

# --- Chỉ dùng khi ASSISTANT_PROVIDER=anthropic (né gateway) ---
# ANTHROPIC_API_KEY=sk-ant-...
# DeepSeek giờ cấu hình ở server/.env: AI_PROVIDER=deepseek + DEEPSEEK_API_KEY

# --- Blueprint checkout (đọc, không sửa) ---
BLUEPRINT_DIR=$HOME/commerce-agents
