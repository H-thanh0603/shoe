# Copy thành agents/.env rồi điền giá trị (KHÔNG commit .env — đã gitignore).
# Nạp bằng: set -a; source agents/.env; set +a  (run_demo.py tự nạp)

# --- Shop ---
KINETIC_API=http://localhost:3100
KINETIC_WEB_URL=http://localhost:3100
KINETIC_ADMIN_EMAIL=admin@kinetic.vn
KINETIC_ADMIN_PASSWORD=doi-mat-khau-nay

# --- LLM: chọn 1 trong 2 ---
# A. Anthropic trực tiếp:
# ANTHROPIC_API_KEY=sk-ant-...
# (model mặc định blueprint: shopping claude-sonnet-5, merchant claude-opus-5)

# B. DeepSeek qua LiteLLM proxy (khuyên dùng cho demo rẻ):
#  1. Điền key:
DEEPSEEK_API_KEY=
#  2. Model DeepSeek (deepseek-chat = V3, tool-use ổn định cho agent;
#     deepseek-reasoner suy luận sâu nhưng gọi tool kém — không khuyên dùng)
DEEPSEEK_MODEL=deepseek-chat
#  3. Chạy proxy (terminal riêng, sau khi source .env):
#      ./agents/run_proxy.sh        # nghe http://localhost:4000
#  4. Trỏ agent vào proxy:
KINETIC_LLM_BASE_URL=http://localhost:4000/v1
KINETIC_LLM_API_KEY=dien-gi-tri-LITELLM_MASTER_KEY-vao-day
KINETIC_SHOPPING_MODEL=deepseek-chat
KINETIC_MERCHANT_MODEL=deepseek-chat
KINETIC_MEMORY_MODEL=deepseek-chat
# Master key của proxy (tự đặt chuỗi ngẫu nhiên, agent dùng nó để gọi proxy):
LITELLM_MASTER_KEY=doi-chuoi-nay

# --- Blueprint checkout (đọc, không sửa) ---
BLUEPRINT_DIR=/tmp/commerce-agents
